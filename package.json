{
  "name": "swu-deck-builder",
  "private": true,
  "version": "0.1.0",
  "license": "WTFPL",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/configure-env.mjs",
    "env:configure": "node scripts/configure-env.mjs",
    "predev": "npm run catalog:ensure",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env --watch server/index.mjs",
    "prestart": "npm run catalog:ensure",
    "start": "node --env-file=.env server/index.mjs",
    "prebuild": "npm run catalog:ensure",
    "build": "vite build",
    "lint": "eslint .",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "prepreview": "npm run catalog:ensure",
    "preview": "vite preview",
    "catalog": "node scripts/catalog.mjs",
    "catalog:ensure": "node scripts/catalog.mjs --ensure",
    "catalog:sync": "node --env-file=.env scripts/sync-catalog.mjs",
    "catalog:sync-all": "node --env-file=.env scripts/sync-catalog.mjs --sync-all",
    "catalog:refresh": "node --env-file=.env scripts/sync-catalog.mjs --refresh",
    "catalog:available": "node --env-file=.env scripts/sync-catalog.mjs --available",
    "catalog:list": "node --env-file=.env scripts/sync-catalog.mjs --list",
    "catalog:pack": "node scripts/pack-catalog.mjs",
    "catalog:agent": "node scripts/build-agent-catalog.mjs",
    "preservice:package": "npm run catalog:ensure",
    "service:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-service.ps1"
  },
  "dependencies": {
    "express": "^5.2.1",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.1.0",
    "concurrently": "^10.0.5",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "vite": "^8.2.2"
  }
}
