{
  "name": "swu-deck-builder",
  "private": true,
  "version": "0.13.1",
  "description": "A local-first Star Wars: Unlimited deck builder.",
  "author": "SWU Deck Builder contributors",
  "license": "WTFPL",
  "type": "module",
  "main": "desktop/main.mjs",
  "scripts": {
    "postinstall": "node scripts/configure-env.mjs",
    "env:configure": "node scripts/configure-env.mjs",
    "predev": "npm run env:configure && npm run catalog:ensure && npm run icons:build",
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1",
    "dev:server": "node --env-file=.env --watch server/index.mjs",
    "prestart": "npm run catalog:ensure",
    "start": "node --env-file=.env server/index.mjs",
    "prebuild": "npm run catalog:ensure && npm run icons:build",
    "build": "vite build",
    "lint": "eslint .",
    "pretest": "npm run icons:build",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "prepreview": "npm run catalog:ensure",
    "preview": "vite preview",
    "catalog": "node scripts/catalog.mjs",
    "catalog:ensure": "node scripts/catalog.mjs --ensure",
    "catalog:sync": "node --env-file=.env scripts/sync-catalog.mjs",
    "catalog:sync-all": "node --env-file=.env scripts/sync-catalog.mjs --sync-all",
    "catalog:refresh": "node --env-file=.env scripts/sync-catalog.mjs --refresh",
    "catalog:refresh-all": "node --env-file=.env scripts/sync-catalog.mjs --refresh-all",
    "catalog:available": "node --env-file=.env scripts/sync-catalog.mjs --available",
    "catalog:list": "node --env-file=.env scripts/sync-catalog.mjs --list",
    "catalog:pack": "node scripts/pack-catalog.mjs",
    "catalog:agent": "node scripts/build-agent-catalog.mjs",
    "icons:build": "node scripts/build-icons.mjs",
    "desktop:start": "npm run build && electron-forge start",
    "desktop:package": "npm run build && electron-forge package",
    "desktop:make": "npm run build && electron-forge make",
    "preservice:package": "npm run catalog:ensure",
    "service:package": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-service.ps1"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "cross-spawn": "^7.0.6",
    "electron-squirrel-startup": "^1.0.1",
    "express": "^5.2.1",
    "openai": "^7.8.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.11.2",
    "@electron-forge/maker-deb": "^7.11.2",
    "@electron-forge/maker-dmg": "^7.11.2",
    "@electron-forge/maker-rpm": "^7.11.2",
    "@electron-forge/maker-squirrel": "^7.11.2",
    "@electron-forge/maker-zip": "^7.11.2",
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.1.0",
    "better-sqlite3": "^12.6.2",
    "concurrently": "^10.0.5",
    "electron": "^44.0.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.11.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "vite": "^8.2.2"
  }
}
