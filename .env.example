# Public catalog fallback. The default URL is shown here for discoverability;
# omit it to use the same value. `npm run catalog` conditionally refreshes a
# local cache from this gzip artifact.
SWU_ENV_SCHEMA_VERSION=2
SWU_PUBLIC_CATALOG_URL=https://swu.wuteri.ch/catalog.json.gz

# Optional private card source used only by the catalog:sync* commands.
SWU_DB_API_BASE_URL=
SWU_DB_SETS_PAGE_URL=

# Local application server.
APP_SERVER_HOST=127.0.0.1
APP_SERVER_PORT=8787
APP_DIST_PATH=dist

# Optional path overrides. Relative paths resolve from the server working
# directory. Production systemd installs use absolute Linux paths.
SWU_CATALOG_PATH=data/catalog.json
SWU_AGENT_CATALOG_PATH=data/agent/catalog.txt
SWU_OPENAI_FILE_CACHE_PATH=data/agent/openai-file-cache.json

# Development-only authoritative deck storage. Remove or leave empty to use
# browser localStorage exclusively. Production always disables this feature.
LOCAL_DECK_DATABASE_PATH=data/local/decks.sqlite

# Local setup auto-detects Codex first, then Claude, and enables AI when found.
# With neither CLI installed, AI stays disabled. The OpenAI API is never chosen
# automatically. Production service installs also keep AI disabled by default.
AGENTIC_DECK_GENERATION_ENABLED=false
AGENTIC_DECK_PROVIDER=

# OpenAI API provider. The API key is read only by the local Node server and is
# never exposed through Vite or sent to the browser.
SWU_OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=medium
OPENAI_MAX_OUTPUT_TOKENS=4000
OPENAI_REQUEST_TIMEOUT_MS=120000
OPENAI_STORE_RESPONSES=false

# codex-cli or claude-cli provider. AGENT_CLI_PATH is optional: when empty, the
# selected `codex` or `claude` executable is detected from PATH. An empty model
# or reasoning value uses that CLI's configured default.
AGENT_CLI_PATH=
AGENT_CLI_MODEL=
AGENT_CLI_REASONING_EFFORT=
# Enables live web search only for codex-cli and claude-cli providers.
AGENT_CLI_WEB_SEARCH_ENABLED=false
AGENT_CLI_TIMEOUT_MS=120000
AGENT_CLI_MAX_OUTPUT_BYTES=1048576
AGENT_CLI_MAX_CONCURRENCY=1
AGENT_CLI_WORK_PATH=data/agent/cli
# Optional provider config/auth root. Leave empty to use the invoking user's
# existing Codex or Claude CLI login; set an isolated writable path in services.
AGENT_CLI_STATE_PATH=

# OpenAI API browser chat sessions. The TTL is renewed after each interaction.
# Local Codex and Claude CLI chat sessions do not expire.
AGENT_SESSION_TTL_MS=600000
AGENT_MAX_SESSIONS=100

# Required for all AI access. Local loopback is allowed by default; an explicit
# empty list denies all AI access. Add only exact client IPv4 or IPv6 addresses.
AGENT_ACCESS_ALLOWED_IPS=127.0.0.1,::1

# Optional simple authentication for clients outside the permanent allowlist.
# A correct password grants the requester's proxy-resolved public IP a fixed,
# in-memory 10-minute lease. Serve the application over HTTPS when enabling it.
AGENT_ACCESS_PASSWORD=
AGENT_ACCESS_LEASE_TTL_MS=600000
# Password attempts are rate-limited separately from AI requests.
AGENT_ACCESS_AUTH_RATE_LIMIT_WINDOW_MS=900000
AGENT_ACCESS_AUTH_RATE_LIMIT_MAX_REQUESTS=5

# Shared per-client-IP limit across AI chat messages and legacy AI endpoints.
# Direct IPv4 and IPv6 loopback requests bypass this limit for local development.
AGENT_RATE_LIMIT_WINDOW_MS=900000
AGENT_RATE_LIMIT_MAX_REQUESTS=5
# Comma- or whitespace-separated exact client IPs. Keep real values only in
# your untracked .env or production service.env file.
AGENT_RATE_LIMIT_BYPASS_IPS=
AGENT_RATE_LIMIT_EXPANDED_IPS=
AGENT_RATE_LIMIT_EXPANDED_MAX_REQUESTS=30

# Optional: reuse a catalog file that was uploaded to the OpenAI Files API.
# When empty, the server uploads and caches one automatically.
OPENAI_CATALOG_FILE_ID=
# Required with a manually configured file ID. The uploaded file must use a
# .txt filename so OpenAI processes every CSV-formatted row as plain text.
OPENAI_CATALOG_FILE_FORMAT=plain-text-csv-v1
